<?xml version="1.0" encoding="UTF-8"?>
<!-- Bare D.C. (Da Capo), no Fine/Coda: <sound dacapo="yes"/> at the end of
     measure 2. Proves the jump fires exactly once - the second time through
     it plays straight to the natural end of the piece rather than looping
     forever or re-firing. Expected next_playback_index step sequence from
     index 0: 0, 1, 0, 1, then None (end). -->
<score-partwise version="4.0">
  <part-list>
    <score-part id="P1">
      <part-name>Classical Guitar</part-name>
      <midi-instrument id="P1-I1">
        <midi-channel>1</midi-channel>
        <midi-program>25</midi-program>
      </midi-instrument>
    </score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <key>
          <fifths>0</fifths>
        </key>
        <time>
          <beats>4</beats>
          <beat-type>4</beat-type>
        </time>
        <clef number="1">
          <sign>G</sign>
          <line>2</line>
        </clef>
      </attributes>
      <note>
        <pitch>
          <step>C</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
        <staff>1</staff>
      </note>
    </measure>
    <measure number="2">
      <note>
        <pitch>
          <step>D</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
        <staff>1</staff>
      </note>
      <direction placement="above">
        <direction-type>
          <words>D.C.</words>
        </direction-type>
        <sound dacapo="yes"/>
      </direction>
    </measure>
  </part>
</score-partwise>
