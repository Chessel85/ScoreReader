<?xml version="1.0" encoding="UTF-8"?>
<!-- No <sound> element anywhere in the file - a D.S. al Coda expressed
     purely via <segno/>/<coda/> sign glyphs and plain <words> text (matches
     MuseScore's own real-world export quirk of sometimes omitting <sound>
     entirely - see e.g. its own testInferCodaII.xml). Exercises the full
     text-only fallback path: glyph-only Segno/Coda marks (no label), a
     text-matched "D.S." (defaults to label "1", matching the glyph-only
     segno's own default label), and a text-matched "To Coda" with no label
     at all, resolved via nearest-following-measure matching rather than an
     exact label match. Expected next_playback_index step sequence from
     index 0: 0, 1, 2, 3, 1, 2, 4, then None (natural end of the coda tail).
     -->
<score-partwise version="4.0">
  <part-list>
    <score-part id="P1">
      <part-name>Classical Guitar</part-name>
      <midi-instrument id="P1-I1">
        <midi-channel>1</midi-channel>
        <midi-program>25</midi-program>
      </midi-instrument>
    </score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <key>
          <fifths>0</fifths>
        </key>
        <time>
          <beats>4</beats>
          <beat-type>4</beat-type>
        </time>
        <clef number="1">
          <sign>G</sign>
          <line>2</line>
        </clef>
      </attributes>
      <note>
        <pitch>
          <step>C</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
        <staff>1</staff>
      </note>
    </measure>
    <measure number="2">
      <direction placement="above">
        <direction-type>
          <segno/>
        </direction-type>
      </direction>
      <note>
        <pitch>
          <step>D</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
        <staff>1</staff>
      </note>
    </measure>
    <measure number="3">
      <note>
        <pitch>
          <step>E</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
        <staff>1</staff>
      </note>
      <direction placement="above">
        <direction-type>
          <words>To Coda</words>
        </direction-type>
      </direction>
    </measure>
    <measure number="4">
      <note>
        <pitch>
          <step>F</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
        <staff>1</staff>
      </note>
      <direction placement="above">
        <direction-type>
          <words>D.S.</words>
        </direction-type>
      </direction>
    </measure>
    <measure number="5">
      <direction placement="above">
        <direction-type>
          <coda/>
        </direction-type>
      </direction>
      <note>
        <pitch>
          <step>G</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
        <staff>1</staff>
      </note>
    </measure>
  </part>
</score-partwise>
