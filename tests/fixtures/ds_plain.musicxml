<?xml version="1.0" encoding="UTF-8"?>
<!-- Plain D.S. (Dal Segno): a <segno/> sign on measure 2 (not measure 1),
     <sound dalsegno="1"/> on measure 3's end. Proves the jump target is the
     SEGNO (measure 2), not the piece's start (measure 1, which is what a
     D.C. would target) - a real test of label-based segno resolution, not
     just "jumps backward". Expected next_playback_index step sequence from
     index 0: 0, 1, 2, 1, 2, then None (end, no Fine/Coda). -->
<score-partwise version="4.0">
  <part-list>
    <score-part id="P1">
      <part-name>Classical Guitar</part-name>
      <midi-instrument id="P1-I1">
        <midi-channel>1</midi-channel>
        <midi-program>25</midi-program>
      </midi-instrument>
    </score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <key>
          <fifths>0</fifths>
        </key>
        <time>
          <beats>4</beats>
          <beat-type>4</beat-type>
        </time>
        <clef number="1">
          <sign>G</sign>
          <line>2</line>
        </clef>
      </attributes>
      <note>
        <pitch>
          <step>C</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
        <staff>1</staff>
      </note>
    </measure>
    <measure number="2">
      <direction placement="above">
        <direction-type>
          <segno/>
        </direction-type>
        <sound segno="1"/>
      </direction>
      <note>
        <pitch>
          <step>D</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
        <staff>1</staff>
      </note>
    </measure>
    <measure number="3">
      <note>
        <pitch>
          <step>E</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
        <staff>1</staff>
      </note>
      <direction placement="above">
        <direction-type>
          <words>D.S.</words>
        </direction-type>
        <sound dalsegno="1"/>
      </direction>
    </measure>
  </part>
</score-partwise>
