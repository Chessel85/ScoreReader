<?xml version="1.0" encoding="UTF-8"?>
<!-- Modelled on files/etude 2.mxl: overlapping/nested wedges, all number="1",
     one staff, so a <wedge type="stop"> must close the innermost (most
     recently opened) wedge first. Four 4/4 bars of quarter notes:
       m1 b1  crescendo (LONG outer) opens
       m1 b3  crescendo (inner A) opens
       m2 b1  stop -> closes inner A
       m2 b3  diminuendo (inner B) opens
       m3 b1  stop -> closes inner B
       m3 b3  stop -> closes the LONG outer
       m4 b3  stop -> nothing open: an unmatched stop (start_known=False)
       m4 b4  crescendo opens and never stops (end_known=False, flushed) -->
<score-partwise version="4.0">
  <part-list>
    <score-part id="P1">
      <part-name>Classical Guitar</part-name>
      <midi-instrument id="P1-I1">
