<?xml version="1.0" encoding="UTF-8"?>
<!-- Combines repeats_and_endings.musicxml's exact repeat/1st-2nd-ending
     shape (measures 1-4) with a later D.C. al Coda (measures 5-7). Proves
     the two features compose correctly end-to-end: the repeat/ending is
     taken once as normal, then once the D.C. fires (measure 6), the repeat
     is NOT retaken and ending 1's content (measure 3) is permanently
     skipped on the second pass, while the coda diversion (measure 5's "To
     Coda") still works correctly on that same second pass.

     Per-measure event counts: m1=1 (index 0), m2=2 sequential half notes
     (indices 1-2), m3=1 (index 3, ending 1 + backward repeat close), m4=1
     (index 4, ending 2), m5=1 (index 5, To Coda), m6=1 (index 6, D.C. al
     Coda), m7=1 (index 7, coda tail).

     Expected next_playback_index step sequence from index 0:
       0, 1, 2, 3,       - m1, m2 (D4,D5), m3 (ending 1) -> repeat fires
       1, 2, 4,          - m2 again, ending 1 skipped -> straight to m4
       5, 6,             - m5 (To Coda inert - jump not yet taken), m6 (D.C. fires)
       0, 1, 2,          - back to m1, m2 - ending 1 STILL skipped (not retaken)
       4, 5,             - m4, m5 (To Coda now fires)
       7,                - coda tail
       then None (natural end).
     -->
<score-partwise version="4.0">
  <part-list>
    <score-part id="P1">
      <part-name>Classical Guitar</part-name>
      <midi-instrument id="P1-I1">
        <midi-channel>1</midi-channel>
        <midi-program>25</midi-program>
      </midi-instrument>
    </score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <key>
          <fifths>0</fifths>
        </key>
        <time>
          <beats>4</beats>
          <beat-type>4</beat-type>
        </time>
        <clef number="1">
          <sign>G</sign>
          <line>2</line>
        </clef>
      </attributes>
      <note>
        <pitch>
          <step>C</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
        <staff>1</staff>
      </note>
    </measure>
    <measure number="2">
      <barline location="left">
        <bar-style>heavy-light</bar-style>
        <repeat direction="forward"/>
      </barline>
      <note>
        <pitch>
          <step>D</step>
          <octave>4</octave>
        </pitch>
        <duration>2</duration>
        <voice>1</voice>
        <type>half</type>
        <staff>1</staff>
      </note>
      <note>
        <pitch>
          <step>D</step>
          <octave>5</octave>
        </pitch>
        <duration>2</duration>
        <voice>1</voice>
        <type>half</type>
        <staff>1</staff>
      </note>
    </measure>
    <measure number="3">
      <barline location="left">
        <ending number="1" type="start">1</ending>
      </barline>
      <note>
        <pitch>
          <step>E</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
        <staff>1</staff>
      </note>
      <barline location="right">
        <bar-style>light-heavy</bar-style>
        <ending number="1" type="discontinue"/>
        <repeat direction="backward"/>
      </barline>
    </measure>
    <measure number="4">
      <barline location="left">
        <ending number="2" type="start">2</ending>
      </barline>
      <note>
        <pitch>
          <step>F</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
        <staff>1</staff>
      </note>
      <barline location="right">
        <bar-style>light-heavy</bar-style>
        <ending number="2" type="discontinue"/>
      </barline>
    </measure>
    <measure number="5">
      <note>
        <pitch>
          <step>G</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
        <staff>1</staff>
      </note>
      <direction placement="above">
        <direction-type>
          <words>To Coda</words>
        </direction-type>
        <sound tocoda="1"/>
      </direction>
    </measure>
    <measure number="6">
      <note>
        <pitch>
          <step>A</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
        <staff>1</staff>
      </note>
      <direction placement="above">
        <direction-type>
          <words>D.C. al Coda</words>
        </direction-type>
        <sound dacapo="yes"/>
      </direction>
    </measure>
    <measure number="7">
      <direction placement="above">
        <direction-type>
          <coda/>
        </direction-type>
        <sound coda="1"/>
      </direction>
      <note>
        <pitch>
          <step>B</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
        <staff>1</staff>
      </note>
    </measure>
  </part>
</score-partwise>
