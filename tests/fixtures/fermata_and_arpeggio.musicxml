<?xml version="1.0" encoding="UTF-8"?>
<!-- P1 (find_feature_plan.md, A5/A6, D7): one part, one complete 4/4 bar.
       beat 1 - a two-note chord (C4 + E4), BOTH notes carrying
                <notations><arpeggiate direction="up"/> - a real "roll this
                chord" arpeggio, so arpeggio = "arpeggio up" on both chord
                members and strum stays unset.
       beat 2 - G4 with a bare <fermata/>            -> "fermata"
       beat 3 - A4 with <fermata>angled</fermata>    -> "angled fermata"
       beat 4 - B4 plain (the absence case)
     Complete bar, so pickup detection does not fire. -->
