<?xml version="1.0" encoding="UTF-8"?>
<!-- Ref 29: one part, 3 complete 4/4 bars of quarter notes, exercising
     crescendo/diminuendo hairpins (<direction>/<direction-type>/<wedge>) -
     no <wedge> element exists anywhere else in this repo, so this is
     hand-authored from scratch:
     - measure 1 beat 3 -> measure 2 beat 2: a crescendo spanning a
       measure boundary (the quarters_from_start comparison case)
     - measure 3 beat 1 -> measure 3 beat 3: a diminuendo fully contained
       within one measure (the same-measure case) -->
