<?xml version="1.0" encoding="UTF-8"?>
<!-- D.C. al Coda: <sound tocoda="1"/> on measure 2's end (inert on the
     first pass), <sound dacapo="yes"/> on measure 3's end, and a coda tail
     (measure 4) carrying <coda/> + <sound coda="1"/> at its start. Proves
     the second pass diverts at "To Coda" straight to the coda tail without
     ever reaching the D.C. mark (measure 3) again. Expected
     next_playback_index step sequence from index 0: 0, 1, 2, 0, 1, 3, then
     None (natural end of the coda tail). -->
<score-partwise version="4.0">
  <part-list>
    <score-part id="P1">
      <part-name>Classical Guitar</part-name>
      <midi-instrument id="P1-I1">
        <midi-channel>1</midi-channel>
        <midi-program>25</midi-program>
      </midi-instrument>
    </score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <key>
          <fifths>0</fifths>
        </key>
        <time>
          <beats>4</beats>
          <beat-type>4</beat-type>
        </time>
        <clef number="1">
          <sign>G</sign>
          <line>2</line>
        </clef>
      </attributes>
      <note>
        <pitch>
          <step>C</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
        <staff>1</staff>
      </note>
    </measure>
    <measure number="2">
      <note>
        <pitch>
          <step>D</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
        <staff>1</staff>
      </note>
      <direction placement="above">
        <direction-type>
          <words>To Coda</words>
        </direction-type>
        <sound tocoda="1"/>
      </direction>
    </measure>
    <measure number="3">
      <note>
        <pitch>
          <step>E</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
        <staff>1</staff>
      </note>
      <direction placement="above">
        <direction-type>
          <words>D.C. al Coda</words>
        </direction-type>
        <sound dacapo="yes"/>
      </direction>
    </measure>
    <measure number="4">
      <direction placement="above">
        <direction-type>
          <coda/>
        </direction-type>
        <sound coda="1"/>
      </direction>
      <note>
        <pitch>
          <step>F</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
        <staff>1</staff>
      </note>
    </measure>
  </part>
</score-partwise>
