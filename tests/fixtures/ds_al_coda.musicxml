<?xml version="1.0" encoding="UTF-8"?>
<!-- D.S. al Coda: <segno/> on measure 2, <sound tocoda="1"/> on measure 3's
     end (inert first pass), <sound dalsegno="1"/> on measure 4's end, and a
     coda tail (measure 5) carrying <coda/> + <sound coda="1"/>. Proves the
     second pass jumps to the segno, then diverts at "To Coda" to the coda
     tail without ever reaching the D.S. mark (measure 4) again. Expected
     next_playback_index step sequence from index 0: 0, 1, 2, 3, 1, 2, 4,
     then None (natural end of the coda tail). -->
<score-partwise version="4.0">
  <part-list>
    <score-part id="P1">
      <part-name>Classical Guitar</part-name>
      <midi-instrument id="P1-I1">
        <midi-channel>1</midi-channel>
        <midi-program>25</midi-program>
      </midi-instrument>
    </score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <key>
          <fifths>0</fifths>
        </key>
        <time>
          <beats>4</beats>
          <beat-type>4</beat-type>
        </time>
        <clef number="1">
          <sign>G</sign>
          <line>2</line>
        </clef>
      </attributes>
      <note>
        <pitch>
          <step>C</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
        <staff>1</staff>
      </note>
    </measure>
    <measure number="2">
      <direction placement="above">
        <direction-type>
          <segno/>
        </direction-type>
        <sound segno="1"/>
      </direction>
      <note>
        <pitch>
          <step>D</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
        <staff>1</staff>
      </note>
    </measure>
    <measure number="3">
      <note>
        <pitch>
          <step>E</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
        <staff>1</staff>
      </note>
      <direction placement="above">
        <direction-type>
          <words>To Coda</words>
        </direction-type>
        <sound tocoda="1"/>
      </direction>
    </measure>
    <measure number="4">
      <note>
        <pitch>
          <step>F</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
        <staff>1</staff>
      </note>
      <direction placement="above">
        <direction-type>
          <words>D.S. al Coda</words>
        </direction-type>
        <sound dalsegno="1"/>
      </direction>
    </measure>
    <measure number="5">
      <direction placement="above">
        <direction-type>
          <coda/>
        </direction-type>
        <sound coda="1"/>
      </direction>
      <note>
        <pitch>
          <step>G</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
        <staff>1</staff>
      </note>
    </measure>
  </part>
</score-partwise>
