<?xml version="1.0" encoding="UTF-8"?>
<!-- P1 (find_feature_plan.md, A8): one guitar part, one complete 4/4 bar.
     notations/technical children BEYOND fret/string/fingering/pluck become
     the comma-joined `technique` attribute; fret/string on the same block
     keep their own keys and are excluded from `technique`.
       C4 - <hammer-on>                 -> technique "hammer on"
       D4 - <harmonic/> + <up-bow/>     -> technique "harmonic, up bow"
       E4 - <fret>3</fret><string>2</string><pull-off>
            -> fret 3, string 2, technique "pull off" (fret/string excluded)
       F4 - plain (absence case)
     Complete bar, so pickup detection does not fire. -->
<score-partwise version="4.0">
  <part-list>
    <score-part id="P1">
      <part-name>Guitar</part-name>
      <score-instrument id="P1-I1">
