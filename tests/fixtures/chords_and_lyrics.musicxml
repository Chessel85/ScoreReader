<?xml version="1.0" encoding="UTF-8"?>
<!-- A real notated part carrying <harmony>/<lyric> markup alongside its
     notes, plus a per-note <notations/arpeggiate> up/down mark used as a
     pick/strum-direction indicator (see parsers/timeline_builder.py's
     _resolve_harmony / the "chord stroke" NoteData it emits) - the fixture
     for TimelineBuilder's synthetic Chords/Lyrics parts, modelled on the
     real-world shape of files/Three Blind Mice.mxl:
     - one A-minor <harmony> at the start of the bar (note 1's position),
       separate from any arpeggiate mark - matching the real file, where
       the bar's harmony and its arpeggiate marks never land on the same
       note
     - "Hel-"/"-lo"/"there" lyrics on notes 1-3, nothing on note 4
     - arpeggiate direction="down" on note 2, "up" on note 3, none on
       notes 1 or 4
     - a trailing rest with no lyric, proving the Lyrics part gets no entry
       there -->
<score-partwise version="4.0">
  <part-list>
    <score-part id="P1">
      <part-name>Piano</part-name>
      <midi-instrument id="P1-I1">
        <midi-channel>1</midi-channel>
        <midi-program>1</midi-program>
      </midi-instrument>
    </score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>2</divisions>
        <key>
          <fifths>0</fifths>
        </key>
        <time>
          <beats>4</beats>
          <beat-type>4</beat-type>
        </time>
        <clef number="1">
          <sign>G</sign>
          <line>2</line>
        </clef>
      </attributes>
      <harmony>
        <root>
          <root-step>A</root-step>
        </root>
        <kind>minor</kind>
      </harmony>
      <note>
        <pitch>
          <step>C</step>
          <octave>5</octave>
        </pitch>
        <duration>2</duration>
        <voice>1</voice>
        <type>quarter</type>
        <staff>1</staff>
        <lyric number="1">
          <syllabic>begin</syllabic>
          <text>Hel</text>
        </lyric>
      </note>
      <note>
        <pitch>
          <step>D</step>
          <octave>5</octave>
        </pitch>
        <duration>2</duration>
        <voice>1</voice>
        <type>quarter</type>
        <staff>1</staff>
        <notations>
          <arpeggiate direction="down"/>
        </notations>
        <lyric number="1">
          <syllabic>end</syllabic>
          <text>lo</text>
        </lyric>
      </note>
      <note>
        <pitch>
          <step>E</step>
          <octave>5</octave>
        </pitch>
        <duration>2</duration>
        <voice>1</voice>
        <type>quarter</type>
        <staff>1</staff>
        <notations>
          <arpeggiate direction="up"/>
        </notations>
        <lyric number="1">
          <syllabic>single</syllabic>
          <text>there</text>
        </lyric>
      </note>
      <note>
        <pitch>
          <step>F</step>
          <octave>5</octave>
        </pitch>
        <duration>1</duration>
        <voice>1</voice>
        <type>eighth</type>
        <staff>1</staff>
      </note>
      <note>
        <rest/>
        <duration>1</duration>
        <voice>1</voice>
        <type>eighth</type>
        <staff>1</staff>
      </note>
    </measure>
  </part>
</score-partwise>
